#!/bin/bash

TARGET_FILE="/etc/login.defs"
NEW_VALUE_1="90"
NEW_VALUE_2="7"
NEW_VALUE_3="14"
NEW_VALUE_4="3"
NEW_VALUE_5="30"
NEW_VALUE_6="SHA512"

sed -i -E "s/^(PASS_MAX_DAYS[[:space:]]+)[0-9]+/\1$NEW_VALUE_1/" "$TARGET_FILE"

sed -i -E "s/^(PASS_MIN_DAYS[[:space:]]+)[0-9]+/\1$NEW_VALUE_2/" "$TARGET_FILE"

sed -i -E "s/^(PASS_WARN_AGE[[:space:]]+)[0-9]+/\1$NEW_VALUE_3/" "$TARGET_FILE"

sed -i -E "s/^(LOGIN_RETIREES[[:space:]]+)[0-9]+/\1$NEW_VALUE_4/" "$TARGET_FILE"

sed -i -E "s/^(LOGIN_TIMEOUT[[:space:]]+)[0-9]+/\1$NEW_VALUE_5/" "$TARGET_FILE"

sed -i -E "s/^(ENCRYPT_METHOD[[:space:]]+)[0-9]+/\1$NEW_VALUE_6/" "$TARGET_FILE"
